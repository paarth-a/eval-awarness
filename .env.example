# Copy to .env and fill in your credentials. Never commit .env.

# OpenRouter API key — used by all judge / rewriter API calls.
# Sign up at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-REPLACE-WITH-YOUR-KEY

# HuggingFace token — required to access the gated Needham donor dataset.
# https://huggingface.co/datasets/jjpn2/eval_awareness
# Request access first, then create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE-WITH-YOUR-TOKEN

# Optional: path to a local clone of the Needham metadata repo (cases + transcripts).
# If unset, falls back to the gated HF dataset via HF_TOKEN.
HF_TELLS_REPO=

# Optional: path to a local clone of the Hawthorne repo, if mirroring upstream.
HAWTHORNE_REPO=

# Activation probing — pick the model to extract on.
# Examples: Qwen/Qwen3-8B, Qwen/Qwen3-32B, Qwen/Qwen3.5-27B, Qwen/Qwen3.5-122B-A10B
ACTPROBE_MODEL=Qwen/Qwen3.5-27B

# Activation probing — cap on samples per (benchmark, condition). Default = unlimited.
ACTPROBE_N_PER=150

# Optional: HuggingFace cache directory (must have ≥200 GB free for the larger Qwen models).
HF_HOME=
